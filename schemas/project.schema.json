{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "version", "knowledge_directory", "runtime_directory", "consumer_checks", "release_evidence", "cli", "plugin", "supported_layouts", "telemetry"],
  "properties": {
    "schema_version": {"const": "agents-project/v5"},
    "version": {"const": "5.0.0"},
    "knowledge_directory": {"const": "docs/memory/entries"},
    "runtime_directory": {"const": ".agents/runtime"},
    "consumer_checks": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "arguments"], "properties": {"path": {"type": "string", "pattern": "\\.ps1$"}, "arguments": {"type": "array", "items": {"type": "string"}}}}},
    "release_evidence": {"const": "docs/evidence/releases/v5.0.0-runtime-evidence.json"},
    "cli": {"const": "scripts/agents.ps1"},
    "plugin": {"const": "plugins/agents-governance/plugin.json"},
    "supported_layouts": {"type": "array", "minItems": 2, "items": {"enum": ["root-layout", "dot-agents-layout"]}},
    "telemetry": {"const": "disabled"}
  }
}
