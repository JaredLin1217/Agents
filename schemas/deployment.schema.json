{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "files"],
  "properties": {
    "schema_version": {"const": "agents-deployment/v3"},
    "files": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "root-layout", "dot-agents-layout"],
      "properties": {"source": {"type": "string", "minLength": 1}, "root-layout": {"type": "string", "minLength": 1}, "dot-agents-layout": {"type": "string", "minLength": 1}}
    }}
  }
}
